# 服务端口(Render 部署会自动注入 PORT,本地默认 3000)
PORT=3000

# SQLite 数据库文件路径
# - 本地留空使用默认值 server/data/vue_admin.db
# - Render 部署用持久磁盘:/data/vue_admin.db(见 render.yaml)
DB_FILE=

# JWT 配置(生产环境务必修改为随机字符串,可用 openssl rand -hex 32 生成)
JWT_ACCESS_SECRET=your_access_secret_change_me
JWT_REFRESH_SECRET=your_refresh_secret_change_me
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_EXPIRES=7d

# CORS 白名单(逗号分隔,放行前端域名)
# - 本地开发默认放行 localhost:5173/4173,无需配置
# - Render 部署时配置为前端 Vercel 地址,例如 https://vue-admin-platform.vercel.app
CORS_ORIGINS=
