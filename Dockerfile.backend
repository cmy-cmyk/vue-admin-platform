# 后端 Dockerfile:多阶段构建(builder 编译 TS + runtime 精简运行)
# 用 Node 22 镜像(支持 node:sqlite 内置模块,Node 22.5+)
# 阶段 1:构建(TypeScript -> JavaScript)
FROM node:22-alpine AS builder
WORKDIR /app
COPY server/package.json server/package-lock.json* ./
RUN npm install
COPY server/ ./
RUN npx tsc -p .

# 阶段 2:运行(只装生产依赖,镜像更小)
FROM node:22-alpine
WORKDIR /app
# 设置生产环境变量
ENV NODE_ENV=production
# 只装生产依赖(排除 devDependencies)
COPY server/package.json server/package-lock.json* ./
RUN npm ci --omit=dev
# 复制编译产物
COPY --from=builder /app/dist ./dist
# 数据卷:SQLite 数据库文件持久化
VOLUME ["/app/data"]
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:3000/api/health || exit 1
# node:sqlite 需要 --experimental-sqlite 标志(Node 22.5+ 内置模块)
CMD ["node", "--experimental-sqlite", "dist/app.js"]
